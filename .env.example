# Local development values only. Use secret management outside local development.
QIP_DB_HOST=localhost
QIP_DB_PORT=5432
QIP_DB_NAME=qip
QIP_DB_USERNAME=qip
QIP_DB_PASSWORD=qip-local-only
QIP_IMAGE=qip:local
QIP_HTTP_PORT=8080
QIP_SPRING_PROFILES=local,ollama
QIP_INVESTIGATOR_USERNAME=qip-investigator
QIP_INVESTIGATOR_PASSWORD=qip-investigator-local-only
QIP_REVIEWER_USERNAME=qip-reviewer
QIP_REVIEWER_PASSWORD=qip-reviewer-local-only
QIP_ADMIN_USERNAME=qip-admin
QIP_ADMIN_PASSWORD=qip-admin-local-only
QIP_OLLAMA_BASE_URL=http://host.docker.internal:11434
QIP_OLLAMA_CHAT_MODEL=qwen3.5:9b
QIP_OLLAMA_CHAT_CONTEXT_LENGTH=8192
QIP_OLLAMA_CHAT_THINK=false
QIP_OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
QIP_OLLAMA_CONNECT_TIMEOUT=5s
QIP_OLLAMA_READ_TIMEOUT=3m
QIP_CONSOLE_LOG_FORMAT=logstash
