# Copy to /opt/qip/deploy/.env on the host, chmod 600, and replace every value.
# Never commit the populated file.
QIP_DOMAIN=qip.example.com
QIP_TLS_EMAIL=operator@example.com
QIP_DB_NAME=qip
QIP_DB_USERNAME=qip
QIP_DB_PASSWORD=replace-with-a-long-random-database-password
QIP_INVESTIGATOR_USERNAME=portfolio-investigator
QIP_INVESTIGATOR_PASSWORD=replace-with-a-long-random-investigator-password
QIP_REVIEWER_USERNAME=portfolio-reviewer
QIP_REVIEWER_PASSWORD=replace-with-a-long-random-reviewer-password
QIP_ADMIN_USERNAME=portfolio-admin
QIP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
